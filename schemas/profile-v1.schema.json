{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Trackpad Gestures profile v1",
  "description": "Structural contract. Runtime also enforces 256 KiB, UTF-8 byte/control-character limits, unique IDs, action reference integrity, URL credentials/host validity, duration order and total gesture+action count <=128 across profiles. Unsupported actions/gestures are data only.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "profiles"
  ],
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "profiles": {
      "type": "array",
      "maxItems": 128,
      "items": {
        "$ref": "#/$defs/profile"
      }
    }
  },
  "$defs": {
    "profile": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "name",
        "gestures",
        "actions"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 512
        },
        "name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 512
        },
        "gestures": {
          "type": "array",
          "maxItems": 128,
          "items": {
            "$ref": "#/$defs/gesture"
          }
        },
        "actions": {
          "type": "array",
          "maxItems": 128,
          "items": {
            "$ref": "#/$defs/action"
          }
        }
      }
    },
    "gesture": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "name",
        "kind",
        "actionID"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 512
        },
        "name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 512
        },
        "kind": {
          "enum": [
            "tap",
            "hold",
            "swipe",
            "pinch",
            "rotate"
          ]
        },
        "direction": {
          "enum": [
            "up",
            "down",
            "left",
            "right"
          ]
        },
        "fingerCount": {
          "type": "integer",
          "minimum": 2,
          "maximum": 5,
          "default": 3
        },
        "zone": {
          "enum": [
            "any",
            "left",
            "right",
            "top",
            "bottom",
            "topLeft",
            "topRight",
            "bottomLeft",
            "bottomRight"
          ]
        },
        "movementThreshold": {
          "type": "number",
          "exclusiveMinimum": 0,
          "maximum": 1
        },
        "minDuration": {
          "type": "number",
          "minimum": 0,
          "maximum": 3600
        },
        "maxDuration": {
          "type": "number",
          "minimum": 0,
          "maximum": 3600
        },
        "modifiers": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "enum": [
              "command",
              "option",
              "control",
              "shift",
              "function",
              "capsLock"
            ]
          }
        },
        "applicationScope": {
          "type": "string",
          "pattern": "^[A-Za-z0-9-]+(\\.[A-Za-z0-9-]+)+$",
          "maxLength": 200
        },
        "priority": {
          "type": "integer",
          "minimum": -100,
          "maximum": 100
        },
        "cooldown": {
          "type": "number",
          "minimum": 0,
          "maximum": 86400
        },
        "actionID": {
          "type": "string",
          "minLength": 1,
          "maxLength": 512
        },
        "requiredCapabilities": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "enum": [
              "pressure",
              "area",
              "highResolution",
              "multiTouch",
              "contactIdentity",
              "normalizedCoordinates",
              "nativeScroll",
              "nativePinch"
            ]
          }
        },
        "enabled": {
          "type": "boolean"
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "kind": {
                "const": "swipe"
              }
            }
          },
          "then": {
            "required": [
              "direction"
            ]
          },
          "else": {
            "not": {
              "required": [
                "direction"
              ]
            }
          }
        }
      ]
    },
    "action": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "id",
            "kind",
            "url"
          ],
          "properties": {
            "id": {
              "type": "string",
              "minLength": 1,
              "maxLength": 512
            },
            "kind": {
              "const": "openURL"
            },
            "url": {
              "type": "string",
              "pattern": "^https?://",
              "maxLength": 512
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "id",
            "kind",
            "bundleID"
          ],
          "properties": {
            "id": {
              "type": "string",
              "minLength": 1,
              "maxLength": 512
            },
            "kind": {
              "const": "launch"
            },
            "bundleID": {
              "type": "string",
              "pattern": "^[A-Za-z0-9-]+(\\.[A-Za-z0-9-]+)+$",
              "maxLength": 200
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "id",
            "kind",
            "bundleID"
          ],
          "properties": {
            "id": {
              "type": "string",
              "minLength": 1,
              "maxLength": 512
            },
            "kind": {
              "const": "focusApp"
            },
            "bundleID": {
              "type": "string",
              "pattern": "^[A-Za-z0-9-]+(\\.[A-Za-z0-9-]+)+$",
              "maxLength": 200
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "id",
            "kind",
            "bundleID"
          ],
          "properties": {
            "id": {
              "type": "string",
              "minLength": 1,
              "maxLength": 512
            },
            "kind": {
              "const": "hideApp"
            },
            "bundleID": {
              "type": "string",
              "pattern": "^[A-Za-z0-9-]+(\\.[A-Za-z0-9-]+)+$",
              "maxLength": 200
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "id",
            "kind",
            "name"
          ],
          "properties": {
            "id": {
              "type": "string",
              "minLength": 1,
              "maxLength": 512
            },
            "kind": {
              "const": "appleShortcut"
            },
            "name": {
              "type": "string",
              "minLength": 1,
              "maxLength": 512
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "id",
            "kind",
            "systemAction"
          ],
          "properties": {
            "id": {
              "type": "string",
              "minLength": 1,
              "maxLength": 512
            },
            "kind": {
              "const": "systemAction"
            },
            "systemAction": {
              "enum": [
                "beep",
                "showDesktop"
              ]
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "id",
            "kind",
            "keycode",
            "modifiers"
          ],
          "properties": {
            "id": {
              "type": "string",
              "minLength": 1,
              "maxLength": 512
            },
            "kind": {
              "const": "keyboardShortcut"
            },
            "keycode": {
              "type": "integer",
              "minimum": 0,
              "maximum": 65535
            },
            "modifiers": {
              "type": "array",
              "uniqueItems": true,
              "items": {
                "enum": [
                  "command",
                  "option",
                  "control",
                  "shift",
                  "function",
                  "capsLock"
                ]
              }
            }
          }
        }
      ]
    }
  }
}
